/-! ## Section 4: Integer Core Reduction -/

/-- Denominator-clearing for support-4: `1/d₁ + 1/d₂ = 1/d₃ + 1/d₄`
    implies `d₃ · d₄ · (d₁ + d₂) = d₁ · d₂ · (d₃ + d₄)`. -/
lemma support4_clearing (d₁ d₂ d₃ d₄ : ℕ)
    (h1 : 0 < d₁) (h2 : 0 < d₂) (h3 : 0 < d₃) (h4 : 0 < d₄)
    (hid : (1 : ℚ) / d₁ + 1 / d₂ = 1 / d₃ + 1 / d₄) :
    d₃ * d₄ * (d₁ + d₂) = d₁ * d₂ * (d₃ + d₄) := by
  have hd1 : (d₁ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hd2 : (d₂ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hd3 : (d₃ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hd4 : (d₄ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have key : (d₃ : ℚ) * d₄ * (d₁ + d₂) = d₁ * d₂ * (d₃ + d₄) := by
    field_simp at hid; nlinarith
  exact_mod_cast key

/-- Integer-core to reciprocal-identity conversion: given a valid integer
    core equation `a + b = c + d` with all terms positive, we get the
    reciprocal identity `1/(b·c·d) + 1/(a·c·d) = 1/(a·b·d) + 1/(a·b·c)`. -/
theorem intCore_to_recip_identity (a b c d : ℕ)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d)
    (hsum : a + b = c + d) :
    (1 : ℚ) / (b * c * d) + 1 / (a * c * d) =
    (1 : ℚ) / (a * b * d) + 1 / (a * b * c) := by
  field_simp;
  norm_cast

/-! ## Section 5: Equivalence Relation -/

/-- Two 4-tuples of denominators are equivalent under the smooth scaling relation. -/
def support4Equiv (d₁ d₂ d₃ d₄ e₁ e₂ e₃ e₄ : ℕ) : Prop :=
  ∃ g : ℕ, 0 < g ∧ isSmooth 3 g ∧
    (  ({e₁, e₂} : Finset ℕ) = {g * d₁, g * d₂} ∧
      ({e₃, e₄} : Finset ℕ) = {g * d₃, g * d₄}
    ∨ ({e₁, e₂} : Finset ℕ) = {g * d₃, g * d₄} ∧
      ({e₃, e₄} : Finset ℕ) = {g * d₁, g * d₂})

/-- The coprime core of a 4-tuple: divide all entries by their gcd. -/
noncomputable def support4Core (d₁ d₂ d₃ d₄ : ℕ) : ℕ × ℕ × ℕ × ℕ :=
  let g := Nat.gcd (Nat.gcd (Nat.gcd d₁ d₂) d₃) d₄
  (d₁ / g, d₂ / g, d₃ / g, d₄ / g)

