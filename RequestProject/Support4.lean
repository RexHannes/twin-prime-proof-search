/-! ## Section 2: Parametric Scaling

Each coprime identity `1/a + 1/b = 1/c + 1/d` generates an infinite family
via scaling: `1/(ga) + 1/(gb) = 1/(gc) + 1/(gd)` for any positive `g`.
-/

/-- Scaling lemma: if `1/a + 1/b = 1/c + 1/d` then `1/(ga) + 1/(gb) = 1/(gc) + 1/(gd)`. -/
theorem support4_scaling (a b c d : ℕ) (g : ℕ) (hg : 0 < g)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d)
    (hid : (1 : ℚ) / a + 1 / b = 1 / c + 1 / d) :
    (1 : ℚ) / (g * a) + 1 / (g * b) = 1 / (g * c) + 1 / (g * d) := by
  have hga : (g : ℚ) * a ≠ 0 := by positivity
  have hgb : (g : ℚ) * b ≠ 0 := by positivity
  have hgc : (g : ℚ) * c ≠ 0 := by positivity
  have hgd : (g : ℚ) * d ≠ 0 := by positivity
  field_simp at hid ⊢
  nlinarith

/-! ## Section 3: Primitivity (Graver Property)

A support-4 identity is **primitive** (a Graver basis element) if no proper
nonzero sub-relation with the same sign pattern exists. For a kernel vector
`(+1, +1, -1, -1)` on denominators `(d₁, d₂, d₃, d₄)`, this means no
proper subset admits a reciprocal identity with the same signs.
-/

/-- Core #1 (4,1,3,2) is primitive: no proper conformal sub-identity exists.
    Denominators: (3,12,4,6). -/
theorem support4_core1_primitive :
    (1 : ℚ) / 3 ≠ 1 / 4 ∧ (1 : ℚ) / 3 ≠ 1 / 6 ∧
    (1 : ℚ) / 12 ≠ 1 / 4 ∧ (1 : ℚ) / 12 ≠ 1 / 6 ∧
    (1 : ℚ) / 3 ≠ 1 / 4 + 1 / 6 ∧ (1 : ℚ) / 12 ≠ 1 / 4 + 1 / 6 ∧
    (1 : ℚ) / 3 + 1 / 12 ≠ 1 / 4 ∧ (1 : ℚ) / 3 + 1 / 12 ≠ 1 / 6 := by
  constructor <;> norm_num

